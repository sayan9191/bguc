NEXT_PUBLIC_SUPABASE_URL=https://bizgybbywllbnuyvcaua.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose in browser bundles or client components.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Organiser login for apps/admin. Required by that app, never committed.
# The static site at docs/bguc/admin does NOT use these: its password lives in
# Supabase as a bcrypt hash (see supabase/migrations/0014_static_organiser.sql).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional. Signs the admin cookie; falls back to ADMIN_PASSWORD when unset.
ADMIN_SESSION_SECRET=

# Optional: used by import script and local tooling
CSV_PATH=data/exhibition_students.csv

# Public voting website origin, used for student share links.
NEXT_PUBLIC_VOTING_SITE_URL=http://localhost:3000

# Optional. Database password from Supabase → Project Settings → Database.
# Used only by: npm run db:apply
DATABASE_URL=
