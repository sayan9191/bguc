{
  "name": "ganesh-exhibition",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:student": "npm run dev --workspace=@exhibition/student",
    "dev:voting": "npm run dev --workspace=@exhibition/voting",
    "dev:admin": "npm run dev --workspace=@exhibition/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "inspect:csv": "tsx scripts/import-students.ts --inspect-only",
    "import:students": "tsx scripts/import-students.ts",
    "db:apply": "tsx scripts/apply-migrations.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "csv-parse": "^5.6.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2"
}
